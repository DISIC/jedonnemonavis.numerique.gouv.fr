{
	"name": "jdma",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start",
		"startB": "next start -p 3001",
		"postinstall": "prisma generate",
		"lint": "prettier --check .",
		"predev": "only-include-used-icons --silent",
		"prebuild": "only-include-used-icons --silent",
		"format": "prettier --write .",
		"lhci:audit": "next build && lhci autorun",
		"lhci:wizard": "lhci wizard"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*": "prettier --write"
	},
	"prisma": {
		"seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} ./prisma/seed.ts"
	},
	"dependencies": {
		"@codegouvfr/react-dsfr": "1.25.3",
		"@elastic/elasticsearch": "8.11.0",
		"@emotion/react": "11.11.1",
		"@emotion/server": "11.11.0",
		"@emotion/styled": "11.11.0",
		"@mui/material": "5.14.6",
		"@prisma/client": "5.14.0",
		"@socialgouv/matomo-next": "1.9.0",
		"@tanstack/react-query": "4.36.1",
		"@trpc-limiter/memory": "1.0.0",
		"@trpc/client": "10.45.4",
		"@trpc/next": "10.45.4",
		"@trpc/react-query": "10.45.4",
		"@trpc/server": "10.45.4",
		"@types/node": "20.5.7",
		"@types/react": "18.2.21",
		"@types/react-dom": "18.2.7",
		"bullmq": "5.73.1",
		"dotenv": "16.3.1",
		"eslint": "8.48.0",
		"eslint-config-next": "15.5.18",
		"i18next": "23.16.8",
		"ioredis": "5.10.1",
		"isomorphic-dompurify": "3.12.0",
		"next": "15.5.18",
		"next-i18next": "15.4.3",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-i18next": "13.5.0",
		"sequelize": "6.37.8",
		"sharp": "0.32.6",
		"superjson": "2.0.0",
		"trpc-openapi": "1.2.0",
		"tss-react": "4.9.0",
		"typescript": "5.2.2",
		"uuid": "11.1.1",
		"zod": "3.23.8",
		"zod-prisma-types": "3.1.8"
	},
	"resolutions": {
		"tar-fs": "3.1.2",
		"ws": "8.21.0",
		"cookie": "1.1.1",
		"qs": "6.15.2",
		"tmp": "0.2.7",
		"postcss": "8.5.15",
		"uuid": "11.1.1"
	},
	"devDependencies": {
		"@babel/core": "7.29.6",
		"@babel/eslint-parser": "7.22.15",
		"@babel/plugin-transform-modules-commonjs": "7.22.15",
		"@babel/preset-env": "7.22.15",
		"@babel/preset-react": "7.22.15",
		"@babel/preset-typescript": "7.22.15",
		"@lhci/cli": "0.12.0",
		"@types/uuid": "11.0.0",
		"eslint-config-prettier": "9.0.0",
		"eslint-plugin-prettier": "5.0.0",
		"husky": "8.0.3",
