{
	"name": "jdma",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"email:dev": "email dev",
		"postinstall": "prisma generate",
		"lint": "prettier --check .",
		"predev": "only-include-used-icons --silent",
		"prebuild": "only-include-used-icons --silent",
		"format": "prettier --write .",
		"lhci:audit": "next build && lhci autorun",
		"lhci:wizard": "lhci wizard",
		"db:reset": "npx prisma migrate reset --force --skip-generate --skip-seed && npx prisma db seed",
		"db:reset:silent": "npx prisma migrate reset --force --skip-generate --skip-seed | awk '/Applying migration/{c++; next} /The following migration/ { next } /migrations\\// { next } /[└├│]─/ { next } {print} END {print \"Applied \" c \" migrations\"\n\n}'",
		"test": "npx cypress run --browser chrome --headed",
		"test:reset": "npm run db:reset:silent && npx prisma db seed && npx cypress run --browser chrome --headed",
		"db:recompute-title-formatted": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' ./scripts/recompute_title_formatted.ts",
		"db:seed-classification": "tsx ./scripts/seed-classification-catalog.ts",
		"albert:spike": "tsx ./scripts/albert-classify-spike.ts",
		"classify:check": "tsx ./scripts/classification-pipeline-check.ts",
		"es:classify-mapping": "tsx ./scripts/es-classification-mapping.ts",
		"worker:export:dev": "tsx watch src/workers/run-export.ts",
		"worker:export:start": "tsx src/workers/run-export.ts",
		"worker:alert:dev": "tsx watch src/workers/run-alert.ts",
		"worker:alert:start": "tsx src/workers/run-alert.ts",
		"worker:classify:dev": "tsx watch src/workers/run-classify.ts",
		"worker:classify:start": "tsx src/workers/run-classify.ts",
		"worker:dev": "tsx watch src/workers/run-all.ts",
		"worker:start": "tsx src/workers/run-all.ts"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*": "npx prettier --write"
	},
	"prisma": {
		"seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} ./prisma/seed.ts"
	},
