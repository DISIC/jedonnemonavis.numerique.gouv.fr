# Albert API (OpenAI-compatible). Copy to `.env` and fill in.
# Reuse the same values as webapp-backoffice/.env — do NOT commit the real key.
ALBERT_API_BASE_URL=https://albert.api.etalab.gouv.fr/v1
ALBERT_API_KEY=
ALBERT_EMBEDDINGS_MODEL=openweight-embeddings
ALBERT_CHAT_MODEL=openweight-small

# Throughput guardrails (stay under the Albert quota).
ALBERT_EMBED_BATCH_SIZE=96
ALBERT_RPM=90

# --- Grist API (push des CSV vers Grist : src.grist_push / src.grist_page) ---
GRIST_BASE_URL=https://grist.numerique.gouv.fr
GRIST_ORG=jdma
GRIST_DOC_ID=
GRIST_API_KEY=
